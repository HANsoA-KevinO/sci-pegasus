# Sci-Pegasus local development. Copy to .env.local and replace every secret.
PORT=3100
APP_PUBLIC_URL=http://localhost:3100
NEXTAUTH_URL=http://localhost:3100
# Auth.js must trust the Host header supplied by the self-hosted Next.js proxy.
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-at-least-32-random-characters

# Dedicated Sci-Pegasus Mongo instance and database. Do not reuse Pegasus URI.
MONGODB_URI=mongodb://127.0.0.1:27018/sci_pegasus

# Durable long-task runner. Use a different secret from AUTH_SECRET.
AGENT_RUNTIME_BACKGROUND_RUNNER=1
AGENT_RUNTIME_WORKERS=8
AGENT_RUNTIME_INTERNAL_BASE_URL=http://127.0.0.1:3100
AGENT_RUNTIME_INTERNAL_SECRET=replace-with-a-second-random-secret-at-least-32-characters

# Execution budgets store cost in USD. Model pricing remains configured and
# audited in RMB; this explicit CNY-per-USD rate is used only for budget conversion.
AGENT_BUDGET_CNY_PER_USD=7.2

# OpenAI-compatible / Anthropic-compatible model gateway used by this project.
LLM_BASE_URL=https://your-llm-gateway.example.com
LLM_API_KEY_ORCHESTRATOR=replace-me
LLM_API_KEY_TOOLS=replace-me

# Literature sources. arXiv works without a key; identify this deployment with
# a real contact address and keep the built-in request throttling enabled.
ARXIV_USER_AGENT="Sci-Pegasus/0.1 (mailto:researcher@example.com)"
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf/

# Sciverse is optional at startup. Sciverse* tools return an actionable
# unavailable result until this dedicated token is configured.
SCIVERSE_API_BASE_URL=https://api.sciverse.space
# SCIVERSE_API_TOKEN=sv-replace-me

# Isolated media storage. GridFS needs no external bucket.
MEDIA_STORAGE_DRIVER=gridfs
SCI_PEGASUS_MEDIA_PREFIX=sci-pegasus/raster-assets
