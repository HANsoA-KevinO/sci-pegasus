# Sci-Pegasus production example. Docker Compose fixes PORT and its Mongo URI.
PORT=3100
APP_PUBLIC_URL=https://sci-pegasus.example.com
NEXTAUTH_URL=https://sci-pegasus.example.com
# Required by Auth.js behind the self-hosted Next.js / reverse-proxy boundary.
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-at-least-32-random-characters

# Used only outside the bundled Compose service. Compose overrides this with
# mongodb://mongo:27017/sci_pegasus to guarantee its dedicated database.
MONGODB_URI=mongodb://127.0.0.1:27018/sci_pegasus

AGENT_RUNTIME_BACKGROUND_RUNNER=1
AGENT_RUNTIME_WORKERS=8
AGENT_RUNTIME_INTERNAL_BASE_URL=http://127.0.0.1:3100
AGENT_RUNTIME_INTERNAL_SECRET=replace-with-a-second-random-secret-at-least-32-characters

# Budget-only conversion from the RMB pricing ledger to USD policy limits.
# Set this explicitly to the deployment's accounting rate.
AGENT_BUDGET_CNY_PER_USD=7.2

LLM_BASE_URL=https://your-llm-gateway.example.com
LLM_API_KEY_ORCHESTRATOR=replace-me
LLM_API_KEY_TOOLS=replace-me

# Literature tools. Use deployment-specific credentials; do not reuse Pegasus
# tokens. arXiv is keyless but should receive an identifiable User-Agent.
ARXIV_USER_AGENT="Sci-Pegasus/0.1 (mailto:researcher@example.com)"
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf/
# Sciverse* tools require this deployment's dedicated token.
SCIVERSE_API_BASE_URL=https://api.sciverse.space
# SCIVERSE_API_TOKEN=sv-replace-me

# GridFS is the self-contained default. If switching to OSS, use a dedicated
# Sci-Pegasus bucket/prefix and fill every OSS_* and CDN variable below.
MEDIA_STORAGE_DRIVER=gridfs
SCI_PEGASUS_MEDIA_PREFIX=sci-pegasus/raster-assets
# MEDIA_PUBLIC_BASE_URL=https://sci-pegasus.example.com
# OSS_REGION=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_CDN_BASE_URL=
# NEXT_PUBLIC_MEDIA_CDN_BASE_URL=
# CRON_SECRET=
